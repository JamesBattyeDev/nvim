  "key_chord_interpretation": {
    "_about": "Reinterprets the raw `key` events from query 05 with the true binding.",
    "<Space>": { "raw_count_normal_mode": 6571, "meaning": "Solo leader press — user pressed Space and waited for which-key. Not a final mapping." },
    "<Space>w": { "raw_count_normal_mode": 2748, "meaning": "<leader>w → :w (save file). This is the real save count — query 13 misses it because <cmd>w<CR> doesn't enter cmdline mode." },
    "<Space><Space>s": { "raw_count_normal_mode": 453, "meaning": "<leader><leader>s → ToggleTerminal(2). Most-used custom terminal slot. NOT a Telescope search." },
    "<C-L>": { "raw_count_normal_mode": 831, "meaning": "Move focus right (<C-w><C-l>) — nvim split nav, no tmux." },
    "<C-H>": { "raw_count_normal_mode": 817, "meaning": "Move focus left (<C-w><C-h>) — nvim split nav." },
    "<C-W>": { "raw_count_normal_mode": 446, "meaning": "Built-in window-operations prefix. Many of these chain to a second key the logger captures as a combined event." },
    "{": { "raw_count_normal_mode": 5681, "meaning": "Prev paragraph. In :terminal buffers uses the custom whitespace-aware jump; in source files uses Vim's default." },
    "}": { "raw_count_normal_mode": 5102, "meaning": "Next paragraph — same as { with direction flipped." }
  },

  "known_logger_limitations_affecting_analysis": [
    "LOG_MODES excludes insert ('i'), command ('c'), terminal-insert ('t'), and replace modes — so <CR> in blink.cmp, <CR> in TelescopePrompt, every typed character in insert, and every terminal input is invisible. Heavy terminal/insert activity is undercounted.",
    "<cmd>...<CR>-style mappings (like <leader>w → <cmd>w<CR>) bypass cmdline mode entirely, so the CmdlineLeave-based queries (02, 10, 13) miss them.",
    "which-key intercepts leader sequences and registers as 'which-key-trigger' before the real mapping resolves — inflating top-mappings (query 01) and obscuring per-mapping counts (07).",
    "Mapping resolution only logs when the resolved mapping has a non-empty `desc`. Many built-in or which-key-internal mappings have empty descs and don't get logged, contributing to the 91% 'abandon' rate in query 16."
  ]
}
